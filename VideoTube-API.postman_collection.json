    {
      "name": "Video Management",
      "item": [
        {
          "name": "Upload Video",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('videoId', jsonData.data.videoId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "thumbnail",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "title",
                  "value": "My Test Video",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "This is a test video upload",
                  "type": "text"
                },
                {
                  "key": "subtitleLanguage",
                  "value": "auto",
                  "type": "text",
                  "description": "Language code for transcription (auto, en, es, fr, hi, etc.). Default: auto"
                },
                {
                  "key": "subtitleTask",
                  "value": "transcribe",
                  "type": "text",
                  "description": "Task type: 'transcribe' (original language) or 'translate' (to English). Default: transcribe"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/videos/upload-abr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "videos",
                "upload-abr"
              ]
            },
            "description": "Upload a video with optional subtitle generation settings. Subtitles are automatically generated using OpenAI Whisper."
          }
        },
