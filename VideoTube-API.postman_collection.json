    {
      "name": "SAS Tokens",
      "item": [
        {
          "name": "Get Download SAS Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sas-tokens/download/{{videoId}}?expiresInSeconds=3600",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sas-tokens",
                "download",
                "{{videoId}}"
              ],
              "query": [
                {
                  "key": "expiresInSeconds",
                  "value": "3600"
                }
              ]
            }
          }
        },
        {
          "name": "Get Upload SAS Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sas-tokens/upload/{{videoId}}?blobPath={{videoId}}/chunk-001.ts&expiresInSeconds=900",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sas-tokens",
                "upload",
                "{{videoId}}"
              ],
              "query": [
                {
                  "key": "blobPath",
                  "value": "{{videoId}}/chunk-001.ts"
                },
                {
                  "key": "expiresInSeconds",
                  "value": "900"
                }
              ]
            }
          }
        },
        {
          "name": "Get HLS Playlist SAS Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sas-tokens/hls-playlist/{{videoId}}/master.m3u8?expiresInSeconds=86400",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sas-tokens",
                "hls-playlist",
                "{{videoId}}",
                "master.m3u8"
              ],
              "query": [
                {
                  "key": "expiresInSeconds",
                  "value": "86400"
                }
              ]
            }
          }
        },
        {
          "name": "Validate SAS Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sasUrl\": \"https://account.blob.core.windows.net/videos/path?sv=2021&sig=...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sas-tokens/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sas-tokens",
                "validate"
              ]
            }
          }
        },
        {
          "name": "Refresh SAS Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoId\": \"{{videoId}}\",\n  \"type\": \"download\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sas-tokens/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sas-tokens",
                "refresh"
              ]
            }
          }
        }
      ]
    },
